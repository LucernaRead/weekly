+    if not os.path.exists(c):
+        print("MISSING in copy:", n); continue
+    a = hashlib.sha256(open(f, "rb").read()).hexdigest()
+    b = hashlib.sha256(open(c, "rb").read()).hexdigest()
+    print(("MATCH " if a == b else "DIFF  ") + n)
