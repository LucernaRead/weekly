+def fc_match(family, bold=False, italic=False):
+    """Resolve a family to (file, index) via fontconfig, or None.
+
+    Weight and slant are orthogonal: regular/bold x upright/italic
+    are four independent faces. D3 (2026-11-11, ru-en P1 WORD OF THE
+    WEEK «чёрная пятница»): webpdf had NO italic handling at all, so
+    italic SVG runs fell back to the upright Lucerna subsets — wrong
+    advances (the closing » sat 3.354 pt loose) and upright glyphs
+    where print uses NotoSerif-MediumItalic + Newsreader-Italic.
+    `:slant=italic` resolves exactly those print faces:
+    Noto Serif -> NotoSerif-MediumItalic.ttf,
+    Newsreader -> Newsreader-Italic.ttf (verified by fc-match).
+    `:slant=oblique` falls back to the same italic faces, so oblique
+    requests are covered by the italic subsets with no extra face.
+    """
+    # CairoSVG requests weight=100 for SVG text with no font-weight and
+    # weight=200 for font-weight=700 (proven by FC_DEBUG on a CairoSVG
+    # render); ':style=Bold' resolves Newsreader-Bold to the Regular file
+    # and bare 'Noto Sans' to Regular while print uses Medium.
+    query = family + (':weight=200' if bold else ':weight=100')
+    if italic:
+        query += ':slant=italic'
     try:
