import sys
sys.path.insert(0, "production/2026-w47/2026-w47-nl-it")
from svglib import wrap
def upper_edge(name, text, kind, size, cur):
    w = 430.0
    while w <= 900.0:
        if wrap(text, kind, False, size, round(w,1)) != cur:
            print(f"{name}: upper edge {round(w-0.1,1)} (changes at {round(w,1)})")
            return round(w-0.1,1)
        w = round(w+0.1,1)
    print(name, "no edge below 900"); return None
D6 = "Completa al passato prossimo. Attenzione agli ausiliari hebben/zijn."
D7 = "de wedstrijd partita; de groepswinst vittoria del girone; de kwartfinale quarti di finale; scoren segnare."
D10 = "Nessuna vera lettera né migliori testi: esempio; promessa passata a VOL.5."
c6 = wrap(D6, "sans", False, 20.5, 422.5)
c7 = wrap(D7, "sans", False, 20.5, 422.5)
c10 = wrap(D10, "sans", False, 20, 378.5)
u6 = upper_edge("D6", D6, "sans", 20.5, c6)
u7 = upper_edge("D7", D7, "sans", 20.5, c7)
u10 = upper_edge("D10", D10, "sans", 20, c10)
print("D6 band 399.9-", u6, "mid", round((399.9+u6)/2,2))
print("D7 band 415.5-", u7, "mid", round((415.5+u7)/2,2))
print("D10 band 343.7-", u10, "mid", round((343.7+u10)/2,2))
