production content12.py diff lines: ['--- ', '+++ ', '@@ -41,7 +41,7 @@', ' f.para("A Torino, domenica 22 novembre, si gioca la finale delle Nitto ATP Finals: otto campioni, una settimana di tennis, e l\'Italia con Flavio Cobolli. A Venezia, sabato 21, c\'è la Madonna della Salute.")', ' f.para("Questa è la quarta edizione de La Lucerna in italiano. Benvenuti in una settimana di calcio, dolci e musica!")', ' f.bridge("HINWEIS · la vetta, die Spitze / der Gipfel · imbattuto, ungeschlagen · il capolista, der Tabellenführer · chiudere, schließen.")', '-f.box("LA SETTIMANA IN CIFRE\u3000DIE WOCHE IN ZAHLEN", [', '+f.box("LA SETTIMANA IN CIFRE\u3000ZAHLEN", [', '     ("29 — Lazios Punkte, Erster nach 11 Spieltagen (Lazio führt mit 29 Punkten)", "serif", False, INK, 20.5, 1.35),', '     ("24 — die Tore des 11. Spieltags, in zehn Spielen (24 Tore in 10 Spielen)", "serif", False, INK, 20.5, 1.35),', '     ("20.45 — Anstoß Atalanta–Inter, Sonntag, 22. November (Sonntag 20:45 Uhr)", "serif", False, INK, 20.5, 1.35),', '@@ -174,7 +174,7 @@', ' f.para("La settimana scorsa si è chiusa con due feste dolci ancora aperte: la Festa del Torrone a Cremona e Eurochocolate a Perugia, che chiudono domenica 22 novembre. E due grandi appuntamenti di sport: le due notti azzurre della Nazionale e l\'inizio delle Nitto ATP Finals a Torino.", 23.5)', ' f.para("Anche la manovra, la legge di bilancio, ha fatto un passo: dal 9 al 12 novembre le commissioni Bilancio di Camera e Senato hanno ascoltato enti e istituzioni. Al momento di andare in stampa, il testo non era ancora legge: ne parliamo a pagina 6.", 23.5)', ' f.bridge("Bei Redaktionsschluss war der Haushaltsentwurf noch kein Gesetz — siehe Seite 6.")', '-f.box("LA FRASE PER RICORDARE\u3000MERKSATZ", [', '+f.box("LA FRASE PER RICORDARE\u3000MERKE", [', '     ("«La salute è la prima ricchezza.» A Venezia, il 21 novembre, la parola «salute» vuol dire salute del corpo e della famiglia.", "serif", False, INK, 21.5, 1.4),', ' ])', ' f.gloss("la salute, die Gesundheit · il ponte votivo, die Votivbrücke · la candela, die Kerze · la peste, die Pest · il voto, das Gelübde · piantare, pflanzen.")']
