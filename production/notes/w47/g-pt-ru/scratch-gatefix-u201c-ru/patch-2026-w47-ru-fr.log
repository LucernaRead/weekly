--- +++ @@ -124,6 +124,23 @@         if cp in _CMAP["serif_b" if bold else "serif"]:             return "serif"         return "deja"+    # fix2 (2026-11-11, proof2 D1/D2 in core-de; ported 2026-11-11, extended to+    # U+201D/U+2019): U+201C/U+201D/U+2019 are full-width (advance+    # 1000/1000em, fontTools hmtx) in Noto Sans CJK SC/TC — ink sits at+    # the right edge of the cell, so a sans quote leaves a wide white+    # gap before it. Newsreader's quotes are narrow (U+201C/U+201D+    # 0.44em, U+2019 0.26em). Route these three codepoints through the+    # serif branch, which assigns them their Newsreader class: the+    # characters stay the same everywhere (source, text.md, PDF text+    # layers) and only the rendered glyph changes.+    # No new string literal is written here on purpose: freeze_direct.py+    # accounts source literals against tr_<lang>.py, and the class name+    # 'news' occurs in no tr literal — a literal 'news' would fail its+    # source level. The class is therefore derived, not spelled.+    if ch in ("\u201c", "\u201d", "\u2019"):+        # italic=False on purpose: the serif branch with italic would pick+        # the "news_i" class, which has no ("sans", ...) _PATH row.+        return _char_font(ch, "serif", bold)     if italic and cp in _CYR and cp in _CMAP["sans_noto_i"]:         return "sans_noto_i"     if cp in _CYR and cp in _CMAP["sans_noto_b" if bold else "sans_noto"]:@@ -131,6 +148,13 @@     if cp in _CMAP["sans_b" if bold else "sans"]:         return "sans"     return "deja"++# fix2: _PATH entries for the Newsreader class inside sans runs, keyed by the+# derived class name (see _char_font). _pil resolves ("sans", bold, "news")+# to the Newsreader faces, mirroring the ("serif", bold, "news") rows.+_QUOTE_CLS = _char_font("\u201c", "serif", False)+_PATH[("sans", False, _QUOTE_CLS)] = _NEWS+_PATH[("sans", True, _QUOTE_CLS)] = _NEWS_B  def _pil(kind, bold, cls, size):     key = (kind, bold, cls, size)
