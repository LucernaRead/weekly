only in SVG text: [('The HungerGames: Sunrise on the Reaping', 1), ("I'm aCelebrity... Get Me Out of Here!", 1), ('The Hunger Games:Sunrise on the Reaping', 1), ('How to Survive theJungle', 1), ('Surprised!', 1), ('A boy goes to the arena. TheGames are cruel and long. He makes afriend and loses her. He wins with a trick,not with force. Then he goes home —changed.', 1), ('Whoscored?', 1), ('Myday. My rights. My future.', 1), ('I wear odd socks forAnti-Bullying Week. Different is good.', 1), ('Break theSilence', 1), ('Myday. My rights.', 1), ('Will Englandwin the Ashes?', 1), ('Englandwon the first Test.', 1), ('254 seats is more than the 218needed.', 1), ('The film is longer than thetrailer.', 1), ('The book is cheaper than thefilm.', 1), ('She willwin.', 1), ('Willthey watch the jungle?', 1), ('Democrats Win the House and theSenate', 1), ('The Ashes are not a sport for earlynights.', 1), ('A midterm changes Congress, not thePresident.', 1), ('The map is drawn. The work starts inJanuary.', 1), ('Two jungles, one week: a paintedjungle in the cinema, and a real jungleon television.', 1), ('A small act is not small to the personit helps — and a loud voice starts withone sentence.', 1), ('On Tuesday, November 3, Americansvoted in the midterm election — for all435 seats in the House ofRepresentatives, for 35 seats in theSenate, and for governor in 36 states.', 1), ('The Democrats win the House in2026.', 1), ('Nobody knows if the count will changeor not whether.', 1), ('Nobody knows whether thecount will change.', 1), ('Dear Lucerna, I read the midterm storywith my class. We counted the seatstogether — 254, 162, 19. My question:when will the count be final? Thank youfor the numbers.', 1), ('The vote is over, but thecounting (114)___.', 1), ('Myday', 1), ('TheDemocrats won the House with 254 seats,', 1), ('And the Senate, with 20 of 33seats called.', 1), ('Is itfinished?', 1), ('The statesmust certify their counts. And two Senateraces are still uncalled.', 1), ('Today is Odd SocksDay.', 1), ('The new Congress (meet) inJanuary.', 1), ('The Democrats (win) theHouse.', 1), ('Nobody knows ___ the count willchange.', 1), ('The Democrats won the Houseand the Senate.', 1), ('The new Congress will meet inJanuary 2027.', 1)]
only in text.md: [('The Hunger Games: Sunrise on the Reaping', 2), ("I'm a Celebrity... Get Me Out of Here!", 1), ('How to Survive the Jungle', 1), ('A boy goes to the arena. The Games are cruel and long. He makes a friend and loses her. He wins with a trick, not with force. Then he goes home — changed.', 1), ('Who scored?', 1), ('Break the Silence', 1), ('My day. My rights. My future.', 1), ('I wear odd socks for Anti-Bullying Week. Different is good.', 1), ('My day. My rights.', 1), ('Will England win the Ashes?', 1), ('England won the first Test.', 1), ('254 seats is more than the 218 needed.', 1), ('The film is longer than the trailer.', 1), ('The book is cheaper than the film.', 1), ('She will win.', 1), ('Will they watch the jungle?', 1), ('Democrats Win the House and the Senate', 1), ('The Ashes are not a sport for early nights.', 1), ('A midterm changes Congress, not the President.', 1), ('The map is drawn. The work starts in January.', 1), ('Two jungles, one week: a painted jungle in the cinema, and a real jungle on television.', 1), ('A small act is not small to the person it helps — and a loud voice starts with one sentence.', 1), ('On Tuesday, November 3, Americans voted in the midterm election — for all 435 seats in the House of Representatives, for 35 seats in the Senate, and for governor in 36 states.', 1), ('The Democrats win the House in 2026.', 1), ('Nobody knows if the count will change or not whether.', 1), ('Nobody knows whether the count will change.', 1), ('Dear Lucerna, I read the midterm story with my class. We counted the seats together — 254, 162, 19. My question: when will the count be final? Thank you for the numbers.', 1), ('The vote is over, but the counting (114)___.', 1), ('My day', 1), ('The Democrats won the House with 254 seats,', 1), ('And the Senate, with 20 of 33 seats called.', 1), ('Is it finished?', 1), ('The states must certify their counts. And two Senate races are still uncalled.', 1), ('Today is Odd Socks Day.', 1), ('The new Congress (meet) in January.', 1), ('The Democrats (win) the House.', 1), ('Nobody knows ___ the count will change.', 1), ('The Democrats won the House and the Senate.', 1), ('The new Congress will meet in January 2027.', 1)]
