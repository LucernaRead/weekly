, "key": "Ce soir, nous allons préparer nos cartables.", "note": "futur proche + préparer"}, {"n": 139, "page": 8, "level": "B2", "type": "翻译", "key": "On ne connaît pas encore les finalistes.", "note": "ne...pas encore = まだ〜ない"}, {"n": 140, "page": 8, "level": "B1", "type": "词汇配对", "key": "a", "note": "tournoi=大会 a"}, {"n": 141, "page": 8, "level": "B1", "type": "词汇配对", "key": "b", "note": "nocturne=夜のイベント b"}, {"n": 142, "page": 8, "level": "B1", "type": "词汇配对", "key": "c", "note": "budget=予算 c"}, {"n": 143, "page": 8, "level": "B1", "type": "词汇配对", "key": "d", "note": "coquille=ホタテ d"}, {"n": 144, "page": 8, "level": "B1", "type": "词汇配对", "key": "e", "note": "festival=音楽祭 e"}, {"n": 145, "page": 8, "level": "A2", "type": "对话补全", "key": "samedi", "note": "11月7日は土曜日"}, {"n": 146, "page": 8, "level": "A2", "type": "对话补全", "key": "coquilles (des coquilles Saint-Jacques)", "note": "市場でホタテを買う"}, {"n": 147, "page": 8, "level": "B1", "type": "对话补全", "key": "goûter", "note": "goûter 味わう（不定詞）"}, {"n": 148, "page": 8, "level": "A2", "type": "对话补全", "key": "recette", "note": "à la portaise は調理法の一つ"}, {"n": 149, "page": 8, "level": "A2", "type": "对话补全", "key": "week-end", "note": "Bon week-end ! よい週末を"}, {"n": 150, "page": 8, "level": "B1", "type": "写作", "key": "自由記述 — ポイントは作文欄に、範文はこのページの作文欄の中にあります", "note": "ポイントで採点"}]