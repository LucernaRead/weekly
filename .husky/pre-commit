#!/usr/bin/env sh

# Regenerate index.json before the commit and include the result in this commit.
# Index drift (an md changed, the index not regenerated) makes consumers show stale data with no error.
# CI catches it, but only after the push. This step moves the check to the moment of the commit.
# --write checks and writes; when the structure is wrong it exits non-zero and the commit is blocked.
node lint.mjs --write

# Add index.json only when it really changed, so the diff stays clean.
if ! git diff --quiet -- index.json; then
  echo "[pre-commit] index.json changed; added to this commit"
  git add index.json
fi
